# Auth.js / Google OAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Trên Vercel có thể đặt true nếu Auth.js báo lỗi UntrustedHost.
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Có thể dùng nhiều email, phân tách bằng dấu phẩy/khoảng trắng; khi đặt biến này, danh sách chỉ gồm các email bên dưới.
ADMIN_EMAILS=balv.airdrop@gmail.com,richworld369.com@gmail.com
# ADMIN_EMAIL vẫn được hỗ trợ cho cấu hình cũ; nếu đặt, chỉ email này được cấp quyền.
ADMIN_EMAIL=balv.airdrop@gmail.com

# Resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Your App <onboarding@resend.dev>
EMAIL_LIST_EXPORT_TO=you@example.com

# Mailjet credentials from the API key management page
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
