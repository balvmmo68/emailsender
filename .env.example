# Auth.js / Google OAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Trên Vercel có thể đặt true nếu Auth.js báo lỗi UntrustedHost.
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Có thể dùng nhiều email, phân tách bằng dấu phẩy/khoảng trắng.
ADMIN_EMAILS=balv.airdrop@gmail.com,richworld369.com@gmail.com
# ADMIN_EMAIL vẫn được hỗ trợ cho cấu hình cũ.
ADMIN_EMAIL=balv.airdrop@gmail.com

# Resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Your App <onboarding@resend.dev>

# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
